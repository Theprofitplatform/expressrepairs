---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileCta from '../components/MobileCta.astro';
import PageScripts from '../components/PageScripts.astro';
import NbnForm from '../components/NbnForm.jsx';
import { SITE } from '../data/site.js';
import { NBN_PLANS } from '../data/plans.js';
import { breadcrumbSchema } from '../lib/seo.js';

const navLinks = [
  { label: 'Repairs', href: '/repairs/' },
  { label: 'Catalogue', href: '/shop/' },
  { label: 'Mobile Plans', href: '/plans/' },
  { label: 'Blog', href: '/blog/' },
];

// Every plan, cheapest first.
const shown = [...NBN_PLANS].sort((a, b) => a.price - b.price);

const schema = breadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'NBN Plans', path: '/nbn/' },
]);
---
<Layout
  title="NBN Plans for Home & Business — No Lock-in, Unlimited Data | Express Repairs"
  description="NBN plans for home and business with no lock-in contracts: unlimited data, free static IP and a free phone number. Local support from our Riverwood store."
  path="/nbn/"
  schema={schema}
  htmlAttrs={{ 'data-palette': 'electric-blue', 'data-fontpair': 'jakarta', 'data-dark': 'false' }}
>
  <SiteNav links={navLinks} ctaHref="#enquire" />

  <main id="main-content">
    <section class="hero" style="padding-bottom: 24px;">
      <div class="hero-bg"></div>
      <div class="container-wide" style="position: relative; z-index: 1;">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="crumb-sep">/</span>
          <span class="crumb-current">NBN Plans</span>
        </nav>
        <span class="hero-badge">
          <span class="hero-badge-pill">New</span>
          <span>NBN for home &amp; business · No lock-in · Free static IP</span>
        </span>
        <h1 class="hero-title" style="font-size: clamp(38px, 5.2vw, 62px); max-width: 760px;">
          Fast NBN for home and business, <em>without the lock-in</em>.
        </h1>
        <p class="hero-sub">
          Month-to-month NBN with unlimited data and a free static IP on every plan — and a local team you can actually call. Tell us your address and we'll confirm the fastest plan available.
        </p>
        <div class="hero-ctas">
          <a href="#plans" class="btn btn-primary btn-lg">See plans</a>
          <a href="#enquire" class="btn btn-ghost btn-lg">Check my address</a>
        </div>
      </div>
    </section>

    <section class="section" id="plans" style="background: var(--bg-soft);">
      <div class="container-wide">
        <span class="eyebrow">NBN Plans</span>
        <h2 class="section-title" style="margin-top: 14px;">Pick your speed. Everything else is included.</h2>
        <p class="section-lede">Every plan is month-to-month — no lock-in, no exit fees. Prices per month inc. GST.</p>

        <div class="nbn-offer-banner">
          <strong>Sign up in store and save.</strong> Most customers qualify for
          <strong>$10/mth off their first 6 months, then $5/mth off ongoing</strong> —
          visit our Riverwood store and we'll sort it out on the spot.
        </div>

        <div class="nbn-controls">
          <div class="nbn-arrows">
            <button type="button" class="nbn-arrow" data-dir="prev" aria-label="Scroll to cheaper plans"><span aria-hidden="true">←</span></button>
            <button type="button" class="nbn-arrow" data-dir="next" aria-label="Scroll to faster plans"><span aria-hidden="true">→</span></button>
          </div>
        </div>

        <div class="plan-grid nbn-grid">
          {shown.map((p) => (
            <div class={`plan ${p.featured ? 'featured' : ''}`}>
              {p.featured && <div class="plan-tag">Most popular</div>}
              <div class="plan-name">{p.name}</div>
              <div class="plan-price">
                <span class="dollar">$</span>
                <span class="num">{p.price}</span>
                <span class="per">/month</span>
              </div>
              <div class="plan-data">Typical business-hour speed {p.typical}</div>
              <ul class="plan-features">
                {p.features.map((f) => <li>{f}</li>)}
                <li>Free phone number (VoIP)</li>
              </ul>
              <p class="nbn-blurb">{p.blurb}</p>
              <a href={`?plan=${encodeURIComponent(p.name)}#enquire`} class={`btn ${p.featured ? 'btn-primary' : 'btn-ghost'} btn-block`}>
                Choose {p.name}
              </a>
            </div>
          ))}
        </div>

        <p class="plan-footer-note">
          Not sure which speed suits you? Call <a href={SITE.phoneHref} style="color: var(--brand-700); font-weight: 700;">{SITE.phone}</a> and we'll size it with you.
          Typical business-hour speeds shown (9am–5pm); speeds during the evening busy period may differ, and actual speeds depend on your NBN technology and address.
          See our <a href="/nbn/terms/" style="color: var(--brand-700); font-weight: 700;">NBN service terms</a>.
        </p>
      </div>
    </section>

    <section class="section" id="phone">
      <div class="container-wide">
        <span class="eyebrow">Phone Line Included</span>
        <h2 class="section-title" style="margin-top: 14px;">Keep your number. It rides along free.</h2>
        <p class="section-lede">
          Every NBN plan includes a phone (VoIP) number at no extra cost — port your existing
          number over for free, or we'll give you a new one. Calls are pay-as-you-go, or add unlimited calling:
        </p>
        <div class="nbn-voip-card">
          <div class="nbn-voip-price"><strong>Unlimited Call Pack — $10/mth</strong></div>
          <ul class="plan-features" style="margin-top: 14px;">
            <li>Unlimited local, national &amp; 13/1300 calls</li>
            <li>Unlimited calls to Australian mobiles</li>
            <li>Unlimited international calls to landlines in 12 countries — UK, NZ, USA, Canada, Germany, France, Hong Kong, China, Japan, Singapore, India &amp; Croatia</li>
            <li>Free number porting, no setup fee</li>
          </ul>
          <p class="nbn-blurb" style="margin-top: 12px;">
            International mobiles and other destinations are charged at standard VoIP rates. The phone service runs over your
            broadband, so it won't work in a power or network outage — including calls to 000. See our
            <a href="/nbn/terms/" style="color: var(--brand-700); font-weight: 600;">service terms</a>.
          </p>
        </div>
      </div>
    </section>

    <section class="section" id="enquire">
      <div class="container-wide" style="max-width: 720px;">
        <span class="eyebrow">Get connected</span>
        <h2 class="section-title" style="margin-top: 14px;">Check availability at your address.</h2>
        <p class="section-lede">We'll confirm what your address supports and call you back — usually within one business day. No lock-in, no exit fees — our <a href="/nbn/terms/" style="color: var(--brand-700); font-weight: 600;">service terms</a> are in plain English.</p>
        <div style="margin-top: 32px;">
          <NbnForm client:visible />
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
  <MobileCta />
  <PageScripts />
</Layout>

<script>
  // Arrow controls for the swipeable plan row — one card per click.
  const row = document.querySelector('.nbn-grid');
  const arrows = [...document.querySelectorAll('.nbn-arrow')];
  if (row && arrows.length) {
    const step = () => row.querySelector('.plan').offsetWidth + 18;
    const sync = () => {
      arrows[0].disabled = row.scrollLeft < 8;
      arrows[1].disabled = row.scrollLeft > row.scrollWidth - row.clientWidth - 8;
    };
    for (const a of arrows) {
      a.addEventListener('click', () => {
        row.scrollBy({ left: a.dataset.dir === 'next' ? step() : -step(), behavior: 'smooth' });
      });
    }
    row.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();
  }
</script>

<style>
  .nbn-offer-banner {
    margin-top: 24px;
    padding: 14px 18px;
    border-radius: 12px;
    background: color-mix(in oklab, var(--brand-500, #2563eb) 10%, transparent);
    border: 1px solid color-mix(in oklab, var(--brand-500, #2563eb) 25%, transparent);
    font-size: 15px;
  }
  /* One swipeable row — cheapest first, scroll right for the faster plans. */
  .nbn-grid {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    /* top padding keeps the -12px "Most popular" tag from being clipped */
    padding: 16px 4px 10px;
    margin-top: 8px;
    scrollbar-width: thin;
    overscroll-behavior-x: contain;
  }
  .nbn-grid > .plan { flex: 0 0 300px; scroll-snap-align: start; }
  @media (max-width: 620px) { .nbn-grid > .plan { flex-basis: 84%; } }

  .nbn-controls {
    display: flex; align-items: center; justify-content: flex-end;
    gap: 16px; flex-wrap: wrap; margin-top: 22px;
  }
  .nbn-arrows { display: flex; gap: 8px; }
  .nbn-arrow {
    width: 42px; height: 42px; border-radius: 50%; cursor: pointer;
    border: 1px solid var(--border); background: var(--surface);
    color: var(--text); font-size: 19px; line-height: 1;
    display: grid; place-items: center;
    transition: border-color .2s ease, color .2s ease, opacity .2s ease;
  }
  .nbn-arrow:hover:not(:disabled) { border-color: var(--brand-600); color: var(--brand-700); }
  .nbn-arrow:disabled { opacity: .3; cursor: default; }

  .nbn-blurb {
    font-size: 14px;
    color: var(--text-subtle, #6b7280);
    margin: 0 0 16px;
  }
  .nbn-voip-card {
    margin-top: 28px;
    max-width: 560px;
    padding: 24px 28px;
    border: 1px solid var(--border);
    border-radius: 22px;
    background: var(--surface);
  }
  .nbn-voip-price { font-size: 20px; }
</style>
