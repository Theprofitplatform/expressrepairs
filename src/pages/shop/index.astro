---
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import MobileCta from '../../components/MobileCta.astro';
import ShopSearch from '../../components/ShopSearch.astro';
import ShopMegaMenu from '../../components/ShopMegaMenu.astro';
import { PRODUCTS } from '../../data/products.js';
import { NAV_LINKS } from '../../data/site.js';
import { slugifyCategory } from '../../lib/shop.js';
import { breadcrumbSchema } from '../../lib/seo.js';

// One tile per category, with its product count — a flat grid of ~3,875
// products is unusable, so /shop/ is a landing page into /shop/c/<category>/.
// Hand-picked tile artwork per category (owner-editable — any product id).
// If a pinned product leaves the catalog, the tile falls back to the first
// R2-hosted product in the category, so a stale pin can't blank a tile.
const TILE_PICKS = {
  'Cases & Covers': 'X-04961', // iPhone 16 MagSafe stand case
  'Cables & Charging': 'X-08163', // Apple 20W USB-C adapter
  'Screen Protection': 'X-01753', // privacy tempered glass on phone
  Audio: 'X-06308', // Baseus Bowie true wireless earbuds
  Accessories: 'X-05283', // magnetic car holder with phone
};

const categories = [...new Set(PRODUCTS.map((p) => p.category))].map((name) => ({
  name,
  slug: slugifyCategory(name),
  count: PRODUCTS.filter((p) => p.category === name).length,
  img: (PRODUCTS.find((p) => p.id === TILE_PICKS[name]) ??
    PRODUCTS.find((p) => p.category === name && p.thumb.includes('img.expressrepairs.com.au')) ??
    PRODUCTS.find((p) => p.category === name))?.thumb,
}));

const schema = breadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Shop', path: '/shop/' },
]);
---
<Layout
  title="Phone Accessories — Cases, Chargers & More | Express Repairs"
  description="Quality phone accessories with fast shipping Australia-wide or free pickup in store at Riverwood Plaza. Cases, screen protectors, chargers, cables and audio."
  path="/shop/"
  schema={schema}
  htmlAttrs={{ 'data-palette': 'electric-blue', 'data-fontpair': 'jakarta', 'data-dark': 'false' }}
>
  <SiteNav links={NAV_LINKS} ctaHref="/shop/cart/" mega />

  <main id="main-content">
  {/* Compact hero: this is a landing page into the categories below, so the
      headline earns one line, not a display-size two. */}
  <section class="hero" style="padding: 28px 0 20px;">
    <div class="hero-bg"></div>
    <div class="container-wide" style="position: relative; z-index: 1;">
      <h1 class="hero-title" style="font-size: clamp(23px, 2.4vw, 28px); max-width: 720px;">
        Shop cases, chargers &amp; more — <em>ready today</em>.
      </h1>
      <p class="hero-sub" style="font-size: 15px; margin-top: 8px; max-width: 640px;">
        Ship Australia-wide (free over $99) or pick up in store at Riverwood Plaza — same stock as our counter.
      </p>
      <div class="shop-hero-tools">
        <ShopSearch />
        <details class="shop-browse">
          <summary class="btn btn-ghost">Browse categories</summary>
          <ShopMegaMenu />
        </details>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 24px;">
    <div class="container-wide">
      {PRODUCTS.length === 0 ? (
        <div class="empty-state" style="text-align: center; padding: 48px 16px;">
          <p class="hero-sub" style="max-width: 480px; margin: 0 auto;">
            Our online range is being loaded. In the meantime, give us a call
            or drop into the shop at Riverwood Plaza — we'll sort you out.
          </p>
          <p style="margin-top: 20px;"><a href="/#contact" class="btn btn-primary btn-sm">Call or visit us</a></p>
        </div>
      ) : (
        <div class="acc-grid acc-grid--tiles">
          {categories.map((cat, i) => (
            <a href={`/shop/c/${cat.slug}/`} class="acc-card">
              {cat.img && (
                <div class="acc-visual">
                  <img
                    src={cat.img}
                    alt={cat.name}
                    loading="eager"
                    fetchpriority={i === 0 ? 'high' : undefined}
                    decoding="async"
                    width="400"
                    height="300"
                    style="width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: contain; background: #fff; padding: 8px; box-sizing: border-box;"
                  />
                </div>
              )}
              <div class="acc-body">
                <div class="acc-title">{cat.name}</div>
                <div class="acc-price">{cat.count} product{cat.count === 1 ? '' : 's'}</div>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
  </main>

  <SiteFooter />
  <MobileCta />
  <script src="../../shop/cart-count.js"></script>
</Layout>
