---
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { PRODUCTS, fmtPrice } from '../../data/products.js';
import { breadcrumbSchema, productSchema, productDescription } from '../../lib/seo.js';
import { specRows, slugifyCategory, relatedProducts, deviceModel, modelGroups, isHocoSupplied } from '../../lib/shop.js';
import { CURATED_TAGS, tagLabel } from '../../lib/tags.js';
import { gridThumb } from '../../shop/search-core.js';
import { SITE, NAV_LINKS } from '../../data/site.js';

export function getStaticPaths() {
  return PRODUCTS.map((p) => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props;
// Same test as lib/seo.js productSchema and shop/google-feed.xml.js — the visible
// page must not say "In stock" while the structured data and product feed say
// OutOfStock. That mismatch is a Merchant Centre policy problem, not just a UI one.
const inStock = p.inStock !== false;
const related = relatedProducts(p, PRODUCTS);
// Link to the model landing page only when Task 3 actually built one (>= 4 products).
const model = deviceModel(p.name);
const hasModelPage =
  model && modelGroups(PRODUCTS.filter((x) => x.category === p.category)).some((g) => g.key === model.key);
// Store-level Google rating only — never emitted as Product aggregateRating.
const googleProfile = (SITE.sameAs || []).find((u) => u.includes('g.page') || u.includes('google'));

// Curated tags only get chips — every chip links to a real landing page.
const curated = (p.tags || []).filter((t) => CURATED_TAGS.some((c) => c.tag === t));
const description = productDescription(p, (p.tags || []).map(tagLabel));

const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Shop', path: '/shop/' },
    { name: p.name, path: `/shop/${p.id}/` },
  ]),
  productSchema(p, description),
];
---
<Layout
  title={`${p.name} | Express Repairs`}
  description={description}
  image={p.image}
  path={`/shop/${p.id}/`}
  schema={schema}
  htmlAttrs={{ 'data-palette': 'electric-blue', 'data-fontpair': 'jakarta', 'data-dark': 'false' }}
>
  <SiteNav links={NAV_LINKS} ctaHref="/shop/cart/" mega />

  <main id="main-content" class="section-tight">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="crumb-sep">/</span>
        <a href="/shop/">Shop</a>
        <span class="crumb-sep">/</span>
        <span class="crumb-current">{p.name}</span>
      </nav>

      <div class="hero-grid" style="margin-top: 32px; align-items: start;">
        <div class="acc-visual" style="border-radius: 20px; border: 1px solid var(--border);">
          <img src={p.image} alt={p.name} width="480" height="480" style="width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: contain; background: #fff; padding: 12px; box-sizing: border-box;" />
        </div>
        <div>
          <h1 style="font-size: clamp(28px, 3.2vw, 38px); font-weight: 800;">{p.name}</h1>
          <p style="font-size: 1.6rem; font-weight: 700; color: var(--brand-700); margin-top: 12px;">{fmtPrice(p.priceCents)}</p>
          {inStock
            ? <p class="acc-desc" style="margin-top: 6px; color: var(--brand-700); font-weight: 600;">In stock — dispatched in {isHocoSupplied(p) ? '2-3' : '1-2'} business days</p>
            : <p class="acc-desc" style="margin-top: 6px; color: var(--muted, #555); font-weight: 600;">Out of stock — <a href={SITE.phoneHref}>call us on {SITE.phone}</a> and we&rsquo;ll order it in.</p>}
          {SITE.rating?.count > 0 && (
            <p style="margin-top: 8px; font-size: 0.95rem;">
              <span style="color: var(--brand-700);" aria-hidden="true">★★★★★</span>{' '}
              {googleProfile
                ? <a href={googleProfile} rel="noopener">Our store: {SITE.rating.value}★ on Google ({SITE.rating.count} reviews)</a>
                : <span>Our store: {SITE.rating.value}★ on Google ({SITE.rating.count} reviews)</span>}
            </p>
          )}
          {inStock && (
            <div style="display: flex; gap: 10px; align-items: center; margin-top: 16px;">
              <input type="number" min="1" max="20" value="1" data-qty aria-label="Quantity" style="width: 70px; padding: 10px; border: 1px solid var(--border); border-radius: 10px;" />
              <button class="btn btn-primary btn-lg" data-add-to-cart data-id={p.id} data-name={p.name} data-price={p.priceCents}>Add to cart</button>
            </div>
          )}
          <p style="margin-top: 16px;"><a href="/shop/cart/">View cart (<span data-cart-count>0</span>)</a></p>
          {hasModelPage && (
            <p style="margin-top: 12px;">
              <a href={`/shop/c/${slugifyCategory(p.category)}/m/${model.key}/`} class="btn btn-ghost btn-sm">
                More {p.category} for {model.label} →
              </a>
            </p>
          )}
          {curated.length > 0 && (
            <nav aria-label="Related collections" class="chip-row" style="margin-top: 16px;">
              {curated.map((t) => (
                <a href={`/shop/t/${t}/`} class="btn btn-ghost btn-sm">{tagLabel(t)}</a>
              ))}
            </nav>
          )}
          <p class="hero-sub" style="margin-top: 20px;">GST included. Flat $10.95 shipping — free over $99 — or free pickup in store at Riverwood Plaza.</p>
          <dl style="margin-top: 24px; display: grid; grid-template-columns: max-content 1fr; gap: 8px 20px; font-size: 0.95rem;">
            {specRows(p).map(([label, value]) => (
              <>
                <dt style="font-weight: 700;">{label}</dt>
                <dd style="margin: 0; color: var(--muted, #555);">
                  {label === 'Category' ? <a href={`/shop/c/${slugifyCategory(p.category)}/`}>{value}</a> : value}
                </dd>
              </>
            ))}
          </dl>
        </div>
      </div>

      {related.length > 0 && (
        <section style="margin-top: 48px;">
          <h2 class="section-title" style="font-size: clamp(22px, 2.4vw, 28px);">More like this</h2>
          <div class="acc-grid acc-grid--dense" style="margin-top: 24px;">
            {related.map((r) => (
              <a href={`/shop/${r.id}/`} class="acc-card">
                <div class="acc-visual">
                  <img
                    src={gridThumb(r.thumb)}
                    onerror={`this.onerror=null;this.src=${JSON.stringify(r.thumb)}`}
                    alt={r.name}
                    loading="lazy"
                    decoding="async"
                    width="400"
                    height="300"
                    style="width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: contain; background: #fff; padding: 12px; box-sizing: border-box;"
                  />
                </div>
                <div class="acc-body">
                  <div class="acc-title">{r.name}</div>
                  <div class="acc-price">{fmtPrice(r.priceCents)}</div>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <p style="margin-top: 40px;"><a href="/shop/">← All accessories</a></p>
    </div>
  </main>

  {inStock && (
    <div class="buy-bar" aria-hidden="false">
      <div class="buy-bar-price">
        <strong>{fmtPrice(p.priceCents)}</strong>
        <span>{isHocoSupplied(p) ? '2-3' : '1-2'} business days</span>
      </div>
      <button class="btn btn-primary" data-add-to-cart data-id={p.id} data-name={p.name} data-price={p.priceCents}>Add to cart</button>
    </div>
  )}

  <SiteFooter />
  <script src="../../shop/cart-count.js"></script>

  <!-- ponytail: scoped here, not global.css — this bar exists only on product pages. -->
  <style>
    .buy-bar { display: none; }
    @media (max-width: 720px) {
      .buy-bar {
        position: fixed;
        left: 0; right: 0; bottom: 0;
        z-index: 40;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
        background: var(--surface, #fff);
        border-top: 1px solid var(--border);
        box-shadow: 0 -4px 16px rgb(0 0 0 / 8%);
      }
      .buy-bar-price { display: flex; flex-direction: column; line-height: 1.2; }
      .buy-bar-price strong { font-size: 1.15rem; color: var(--brand-700); }
      .buy-bar-price span { font-size: 0.78rem; color: var(--muted, #555); }
      .buy-bar .btn { margin-left: auto; }
      /* Keep the footer clear of the fixed bar. */
      main { padding-bottom: 76px; }
    }
  </style>
</Layout>
