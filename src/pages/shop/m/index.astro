---
// Hub for the 118 cross-category model pages — the target of the mega menu's
// "All N models →" links, and the one place every /shop/m/ page is linked from.
import Layout from '../../../layouts/Layout.astro';
import SiteNav from '../../../components/SiteNav.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import MobileCta from '../../../components/MobileCta.astro';
import { MODEL_FAMILIES, MODEL_ROUTES } from '../../../lib/shopMenu.js';
import { breadcrumbSchema } from '../../../lib/seo.js';

const navLinks = [
  { label: 'Repairs', href: '/repairs/' },
  { label: 'Shop', href: '/shop/' },
];

const schema = breadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Shop', path: '/shop/' },
  { name: 'Device models', path: '/shop/m/' },
]);
---
<Layout
  title="Shop by Phone & Tablet Model | Express Repairs"
  description={`Find cases, screen protectors, chargers and accessories for ${MODEL_ROUTES.length} phone and tablet models. Ship Australia-wide or free pickup at Riverwood Plaza.`}
  path="/shop/m/"
  schema={schema}
  htmlAttrs={{ 'data-palette': 'electric-blue', 'data-fontpair': 'jakarta', 'data-dark': 'false' }}
>
  <SiteNav links={navLinks} ctaHref="/shop/cart/" mega />

  <main id="main-content" class="section-tight">
    <div class="container-wide">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="crumb-sep">/</span>
        <a href="/shop/">Shop</a>
        <span class="crumb-sep">/</span>
        <span class="crumb-current">Device models</span>
      </nav>

      <h1 class="section-title" style="margin-top: 16px; font-size: clamp(28px, 3.2vw, 38px);">
        Shop by device model
      </h1>
      <p class="hero-sub">
        {MODEL_ROUTES.length} models — pick yours to see every case, protector, charger and
        accessory that fits it.
      </p>

      {MODEL_FAMILIES.map(({ family, models }) => (
        <section style="margin-top: 32px;">
          <h2 class="section-title" style="font-size: 20px; margin-bottom: 12px;">
            {family} <span class="model-count">({models.length} model{models.length === 1 ? '' : 's'})</span>
          </h2>
          <div class="chip-row">
            {models.map((m) => (
              <a href={`/shop/m/${m.key}/`} class="btn btn-ghost btn-sm">
                {m.label} <span style="opacity:.6">({m.count})</span>
              </a>
            ))}
          </div>
        </section>
      ))}

      <p style="margin-top: 40px;"><a href="/shop/">← All categories</a></p>
    </div>
  </main>

  <SiteFooter />
  <MobileCta />
  <script src="../../../shop/cart-count.js"></script>
</Layout>
