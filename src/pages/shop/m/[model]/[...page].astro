---
// Cross-category device pages: everything we stock for one model, across all
// nine categories. The category-scoped /shop/c/<cat>/m/<model>/ pages still
// exist and are linked from the chip row below — this page funnels into them.
import Layout from '../../../../layouts/Layout.astro';
import SiteNav from '../../../../components/SiteNav.astro';
import SiteFooter from '../../../../components/SiteFooter.astro';
import MobileCta from '../../../../components/MobileCta.astro';
import ShopFilters from '../../../../components/ShopFilters.astro';
import ProductCard from '../../../../components/ProductCard.astro';
import { PRODUCTS } from '../../../../data/products.js';
import { slugifyCategory, deviceModel } from '../../../../lib/shop.js';
import { MODEL_ROUTES } from '../../../../lib/shopMenu.js';
import { breadcrumbSchema, itemListSchema } from '../../../../lib/seo.js';
import { CURATED_TAGS, MIN_TAG_PAGE_PRODUCTS } from '../../../../lib/tags.js';

export function getStaticPaths({ paginate }) {
  return MODEL_ROUTES.flatMap(({ key, label }) => {
    const items = PRODUCTS.filter((p) => deviceModel(p.name)?.key === key);
    return paginate(items, { pageSize: 48, params: { model: key }, props: { modelLabel: label } });
  });
}

const { page, modelLabel } = Astro.props;
const { model: modelKey } = Astro.params;

const bucket = PRODUCTS.filter((p) => deviceModel(p.name)?.key === modelKey);

// Narrow-down links into the existing category-scoped model pages. Only
// categories that actually have a page for this model (modelGroups' own
// min of 4) — anything thinner would 404.
const catChips = [...new Set(bucket.map((p) => p.category))]
  .map((name) => ({
    name,
    slug: slugifyCategory(name),
    count: bucket.filter((p) => p.category === name).length,
  }))
  .filter((c) => c.count >= 4)
  .sort((a, b) => b.count - a.count);

const brandCounts = [...new Set(bucket.map((p) => p.brand).filter(Boolean))]
  .sort()
  .map((name) => ({ name, count: bucket.filter((p) => p.brand === name).length }));

const tagChips = CURATED_TAGS.map((t) => ({
  ...t,
  count: bucket.filter((p) => p.tags.includes(t.tag)).length,
})).filter((t) => t.count >= MIN_TAG_PAGE_PRODUCTS);

const navLinks = [
  { label: 'Repairs', href: '/repairs/' },
  { label: 'Catalogue', href: '/shop/' },
];

const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Shop', path: '/shop/' },
    { name: modelLabel, path: `/shop/m/${modelKey}/` },
  ]),
  itemListSchema(page),
];
---
<Layout
  title={`${modelLabel} Cases, Chargers & Accessories | Express Repairs`}
  description={`Everything we stock for the ${modelLabel} — cases, screen protectors, chargers and more. Ship Australia-wide (free over $99) or free pickup at Riverwood Plaza.`}
  path={page.url.current}
  schema={schema}
  htmlAttrs={{ 'data-palette': 'electric-blue', 'data-fontpair': 'jakarta', 'data-dark': 'false' }}
>
  <SiteNav links={navLinks} ctaHref="/shop/cart/" mega />

  <main id="main-content" class="section-tight">
    <div class="container-wide">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="crumb-sep">/</span>
        <a href="/shop/">Shop</a>
        <span class="crumb-sep">/</span>
        <span class="crumb-current">{modelLabel}</span>
      </nav>

      <h1 class="section-title" style="margin-top: 16px; font-size: clamp(28px, 3.2vw, 38px);">
        {modelLabel} accessories
      </h1>
      <p class="hero-sub">
        {page.total} products for the {modelLabel} — same stock as our counter at Riverwood Plaza.
      </p>

      {catChips.length > 1 && (
        <nav class="chip-row" aria-label={`${modelLabel} by category`} style="margin-top: 16px;">
          {catChips.map((c) => (
            <a href={`/shop/c/${c.slug}/m/${modelKey}/`} class="btn btn-ghost btn-sm">
              {c.name} <span style="opacity:.6">({c.count})</span>
            </a>
          ))}
        </nav>
      )}

      <ShopFilters model={modelKey} brands={brandCounts} tags={tagChips} />

      <div class="acc-grid acc-grid--dense" style="margin-top: 24px;">
        {page.data.map((p) => <ProductCard p={p} />)}
      </div>

      <div id="pagination" style="display: flex; align-items: center; justify-content: center; gap: 24px; margin-top: 40px;">
        {page.url.prev ? <a href={page.url.prev} class="btn btn-ghost btn-sm">← Previous</a> : <span />}
        <span class="hero-sub" style="margin: 0;">Page {page.currentPage} of {page.lastPage}</span>
        {page.url.next ? <a href={page.url.next} class="btn btn-ghost btn-sm">Next →</a> : <span />}
      </div>

      <p style="margin-top: 40px;"><a href="/shop/m/">← All device models</a></p>
    </div>
  </main>

  <SiteFooter />
  <MobileCta />
  <script src="../../../../shop/cart-count.js"></script>
</Layout>
