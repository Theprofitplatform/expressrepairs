---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileCta from '../components/MobileCta.astro';
import PageScripts from '../components/PageScripts.astro';
import { Plans } from '../components/sections.jsx';
import { SITE } from '../data/site.js';
import { breadcrumbSchema } from '../lib/seo.js';

const navLinks = [
  { label: 'Repairs', href: '/repairs/' },
  { label: 'Phones', href: '/phones/' },
  { label: 'NBN Plans', href: '/nbn/' },
  { label: 'Shop', href: '/shop/' },
];

const schema = breadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Mobile Plans', path: '/plans/' },
]);
---
<Layout
  title="Mobile Plans — SIM Only & With Handset | Express Repairs"
  description="Mobile plans on a trusted network — SIM only or with a handset. Keep your number, swap anytime, data banking and gifting included. Set up in our Riverwood store."
  path="/plans/"
  schema={schema}
  htmlAttrs={{ 'data-palette': 'electric-blue', 'data-fontpair': 'jakarta', 'data-dark': 'false' }}
>
  <SiteNav links={navLinks} ctaHref="/#contact" />

  <main id="main-content">
    <section class="hero" style="padding-bottom: 0;">
      <div class="hero-bg"></div>
      <div class="container-wide" style="position: relative; z-index: 1;">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="crumb-sep">/</span>
          <span class="crumb-current">Mobile Plans</span>
        </nav>
        <h1 class="hero-title" style="font-size: clamp(38px, 5.2vw, 62px); max-width: 760px;">
          Mobile plans, <em>sorted in store</em>.
        </h1>
        <p class="hero-sub">
          SIM only or with a handset — we'll port your number and have you connected before you
          leave the shop. Need home or business internet too? See our
          <a href="/nbn/" style="color: var(--brand-700); font-weight: 700;">NBN plans</a>.
        </p>
      </div>
    </section>

    <Plans client:visible ctaHref={SITE.phoneHref} />
  </main>

  <SiteFooter />
  <MobileCta />
  <PageScripts />
</Layout>
