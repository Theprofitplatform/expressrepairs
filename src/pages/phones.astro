---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileCta from '../components/MobileCta.astro';
import PageScripts from '../components/PageScripts.astro';
import PhonesForm from '../components/PhonesForm.jsx';
import { SITE } from '../data/site.js';
import { breadcrumbSchema } from '../lib/seo.js';

const navLinks = [
  { label: 'Repairs', href: '/repairs/' },
  { label: 'Shop', href: '/shop/' },
  { label: 'Mobile Plans', href: '/plans/' },
  { label: 'NBN Plans', href: '/nbn/' },
  { label: 'Blog', href: '/blog/' },
];

const schema = breadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'New & Refurbished Phones', path: '/phones/' },
]);
---
<Layout
  title="New & Refurbished Phones — Tested, 12-Month Warranty | Express Repairs"
  description="Buy new and refurbished phones in Riverwood, Sydney. Every refurbished phone is tested by our repair technicians and backed by a 12-month warranty. Trade-ins welcome."
  path="/phones/"
  schema={schema}
  htmlAttrs={{ 'data-palette': 'electric-blue', 'data-fontpair': 'jakarta', 'data-dark': 'false' }}
>
  <SiteNav links={navLinks} ctaHref="#enquire" />

  <main id="main-content">
    <section class="hero" style="padding-bottom: 24px;">
      <div class="hero-bg"></div>
      <div class="container-wide" style="position: relative; z-index: 1;">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="crumb-sep">/</span>
          <span class="crumb-current">Phones</span>
        </nav>
        <span class="hero-badge">
          <span class="hero-badge-pill">In store</span>
          <span>New &amp; refurbished phones · 12-month warranty · Trade-ins welcome</span>
        </span>
        <h1 class="hero-title" style="font-size: clamp(38px, 5.2vw, 62px); max-width: 780px;">
          Phones tested by the people <em>who repair them</em>.
        </h1>
        <p class="hero-sub">
          We sell new and refurbished phones from our Riverwood store. Every refurbished phone is
          inspected and tested by our own repair technicians and backed by a 12-month warranty —
          and you can bring your old phone in as a trade-in. Stock changes daily, so call or
          message us for today's models and prices.
        </p>
        <div class="hero-ctas">
          <a href={SITE.phoneHref} class="btn btn-primary btn-lg">Call {SITE.phone}</a>
          <a href="#enquire" class="btn btn-ghost btn-lg">Ask what's in stock</a>
        </div>
      </div>
    </section>

    <section class="section" id="refurbished" style="background: var(--bg-soft);">
      <div class="container-wide">
        <span class="eyebrow">Refurbished Phones</span>
        <h2 class="section-title" style="margin-top: 14px;">Refurbished, the way a repair shop does it.</h2>
        <p class="section-lede">
          We fix phones for a living — so before a refurbished phone goes on our shelf, it gets the
          same full inspection our repair customers pay for. Mostly iPhone and Samsung Galaxy, with
          other brands passing through depending on trade-ins.
        </p>
        <div class="phones-cards">
          <div class="phones-card">
            <h3>Tested by technicians</h3>
            <ul class="plan-features">
              <li>Screen, battery health, cameras, speakers, mic, charging port and buttons all checked</li>
              <li>Battery replaced if it doesn't hold up</li>
              <li>Genuine condition described honestly — no surprises</li>
            </ul>
          </div>
          <div class="phones-card">
            <h3>12-month warranty</h3>
            <ul class="plan-features">
              <li>Every refurbished phone carries a 12-month warranty</li>
              <li>Warranty work done here in store — no posting it away</li>
              <li>Your rights under Australian Consumer Law apply on top</li>
            </ul>
          </div>
          <div class="phones-card">
            <h3>Ready to go</h3>
            <ul class="plan-features">
              <li>Unlocked — works with any Australian network</li>
              <li>Factory reset and updated before handover</li>
              <li>Cases, screen protectors and chargers in store — fitted while you wait</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="new">
      <div class="container-wide">
        <span class="eyebrow">New Phones</span>
        <h2 class="section-title" style="margin-top: 14px;">New phones, sealed in box.</h2>
        <p class="section-lede">
          We also stock brand-new phones — sealed, with the full manufacturer's warranty. Walk out
          with it set up, data transferred from your old phone, case and screen protector fitted.
          If we don't have the model you want on the shelf, we can usually get it in fast.
        </p>
      </div>
    </section>

    <section class="section" id="trade-in" style="background: var(--bg-soft);">
      <div class="container-wide">
        <span class="eyebrow">Trade-ins</span>
        <h2 class="section-title" style="margin-top: 14px;">Your old phone is worth something.</h2>
        <p class="section-lede">
          Bring your old phone in and put its value toward your next one — we'll check it over and
          make you an offer on the spot. Cracked screen or flat battery? Still bring it in: we're a
          repair shop, so a phone that's "worthless" elsewhere often isn't here.
        </p>
        <p class="section-lede" style="margin-top: 12px;">
          Not upgrading? We also <a href="/repairs/" style="color: var(--brand-700); font-weight: 700;">repair phones</a> same-day.
        </p>
      </div>
    </section>

    <section class="section" id="enquire">
      <div class="container-wide" style="max-width: 720px;">
        <span class="eyebrow">Today's stock</span>
        <h2 class="section-title" style="margin-top: 14px;">Ask what's in stock right now.</h2>
        <p class="section-lede">
          Phone stock moves daily, so we don't publish a price list that's out of date by lunchtime.
          Tell us what you're after — or call <a href={SITE.phoneHref} style="color: var(--brand-700); font-weight: 700;">{SITE.phone}</a> —
          and we'll come back with today's models and prices.
        </p>
        <div style="margin-top: 32px;">
          <PhonesForm client:visible />
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
  <MobileCta />
  <PageScripts />
</Layout>

<style>
  .phones-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
    margin-top: 28px;
  }
  .phones-card {
    padding: 24px 26px;
    border: 1px solid var(--border);
    border-radius: 22px;
    background: var(--surface);
  }
  .phones-card h3 { font-size: 18px; margin: 0 0 6px; }
</style>
