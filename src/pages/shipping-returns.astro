---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageScripts from '../components/PageScripts.astro';
import { SITE } from '../data/site.js';
import { breadcrumbSchema } from '../lib/seo.js';

const navLinks = [
  { label: 'Repairs', href: '/repairs/' },
  { label: 'Catalogue', href: '/shop/' },
  { label: 'NBN Plans', href: '/nbn/' },
  { label: 'Blog', href: '/blog/' },
];

const schema = breadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Shipping & Returns', path: '/shipping-returns/' },
]);
---
<Layout
  title="Shipping & Returns | Express Repairs"
  description="Shipping costs and delivery times for the Express Repairs online catalogue, free in-store pickup, and returns under Australian Consumer Law."
  path="/shipping-returns/"
  schema={schema}
  htmlAttrs={{ 'data-palette': 'electric-blue', 'data-fontpair': 'jakarta', 'data-dark': 'false' }}
>
  <SiteNav links={navLinks} ctaHref="/#contact" />

  <main id="main-content">
    <section class="section">
      <div class="container-wide terms-wrap">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="crumb-sep">/</span>
          <span class="crumb-current">Shipping &amp; Returns</span>
        </nav>

        <h1 class="section-title" style="margin-top: 20px;">Shipping &amp; Returns</h1>
        <p class="terms-updated">Effective 3 August 2026</p>

        <p>
          This page covers accessories and products ordered through our
          <a href="/shop/">online catalogue</a>. Orders placed through the site are order requests — we call
          you to confirm before anything is charged or shipped (see our
          <a href="/terms/">Terms of Service</a> for how that works).
        </p>

        <h2>1. Pickup in store — free</h2>
        <p>
          Pick up your order free at {SITE.storeName}, {SITE.addressShort}. We'll tell you when it's ready
          on the confirmation call — items we have on the shelf are usually ready the same day.
        </p>

        <h2>2. Delivery</h2>
        <ul>
          <li><strong>Flat $10.95 shipping Australia-wide</strong> — free on orders over $99.</li>
          <li>Items in stock at the store are dispatched in 1–2 business days once your order is confirmed.</li>
          <li>Some catalogue items are ordered in from our supplier and dispatch in 2–3 business days — the product page shows the dispatch time for each item.</li>
          <li>Delivery is by Australia Post; transit times depend on your location and are in addition to the dispatch time. We'll give you a realistic estimate on the confirmation call.</li>
        </ul>
        <p>
          All prices include GST. If a parcel goes missing or arrives damaged, call us on {SITE.phone} and
          we'll sort it out — a damaged-in-transit item is our problem to fix, not yours.
        </p>

        <h2>3. Returns and refunds — your rights</h2>
        <p>
          Our goods come with guarantees that cannot be excluded under the Australian Consumer Law. Among
          other things, goods must be of acceptable quality, fit for their purpose and match their
          description. If something you bought from us doesn't meet those guarantees:
        </p>
        <ul>
          <li><strong>Major failure</strong> — you can choose a refund or a replacement, and compensation for any other reasonably foreseeable loss or damage.</li>
          <li><strong>Minor failure</strong> — we'll repair or replace the item, or refund it, within a reasonable time.</li>
        </ul>
        <p>
          These rights apply however you bought the item — online order or over the counter — and are not
          limited to any warranty period. We're not required to provide a refund or replacement if you
          simply change your mind, but your consumer guarantee rights above always apply.
        </p>

        <h2>4. How to make a claim</h2>
        <ul>
          <li>Call {SITE.phone} or bring the item into the store at {SITE.addressShort}.</li>
          <li>Bring or reference your proof of purchase — your receipt, or the order confirmation we gave you.</li>
          <li>We'll assess the item and give you the remedy the Australian Consumer Law entitles you to. Most claims are sorted on the spot at the counter.</li>
        </ul>

        <h2>5. Repairs and warranty claims</h2>
        <p>
          Repair services come with the warranty stated on the relevant repair page, in addition to your
          Australian Consumer Law rights. If a repair we did isn't right, bring the phone back with your
          receipt and we'll make it right.
        </p>

        <p class="terms-note">
          Questions about an order or a return? Call <a href={SITE.phoneHref}>{SITE.phone}</a> or visit us
          at {SITE.addressShort}.
        </p>

        <a href="/shop/" class="btn btn-ghost" style="margin-top: 24px;">← Back to the catalogue</a>
      </div>
    </section>
  </main>

  <SiteFooter />
  <PageScripts />
</Layout>

<style>
  .terms-wrap { max-width: 760px; }
  .terms-wrap h2 { font-size: 22px; margin: 36px 0 12px; }
  .terms-wrap p, .terms-wrap li { font-size: 16px; line-height: 1.7; color: var(--text-muted); }
  .terms-wrap ul { padding-left: 22px; margin: 12px 0; display: flex; flex-direction: column; gap: 8px; }
  .terms-wrap a { color: var(--brand-700); font-weight: 600; }
  .terms-updated { font-size: 14px; color: var(--text-subtle); margin: 8px 0 28px; }
  .terms-note { margin-top: 36px; font-size: 14px; }
</style>
