---
import '../styles/global.css';
import '../styles/local-page.css';
import '../styles/blog.css';
import { canonical, absoluteUrl } from '../lib/seo.js';
import { SITE } from '../data/site.js';
import SiteAnalytics from '../components/SiteAnalytics.astro';
import AdTracking from '../components/AdTracking.astro';

const {
  title,
  description = '',
  path = '/',
  schema = [],          // array of JSON-LD objects
  htmlAttrs = {},       // e.g. data-palette etc. carried from the original <html>
  ogType = 'website',   // 'article' for blog posts
  image = SITE.image,   // share image path; defaults to the site share image
  noindex = false,
} = Astro.props;

if (!title) throw new Error('Layout.astro requires a `title` prop');

const url = canonical(path);
const ogImage = image ? absoluteUrl(image) : null;
const jsonld = Array.isArray(schema) ? schema : [schema];

// Google Customer Reviews badge is scoped to the shop — it rates the store, and
// until ratings accumulate it renders "no rating available", which repair
// customers don't need to see. Build-time check: the scripts aren't emitted at
// all elsewhere. Every page under src/pages/shop/ passes a `path`.
const shopBadge = path.startsWith('/shop/');

const FONTS_HREF =
  'https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap';
---
<!doctype html>
<html lang="en-AU" {...htmlAttrs}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a66ff" />
    <meta name="google-site-verification" content="APLrxdxmjG_dPQxqJeToSjMbPUKO7ARelO1_5TggFms" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Load fonts without blocking first paint; swap to all media once loaded. */}
    <link rel="preload" as="style" href={FONTS_HREF} />
    <link rel="stylesheet" href={FONTS_HREF} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={FONTS_HREF} /></noscript>

    {jsonld.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}

    <SiteAnalytics />
    <AdTracking />
    <script is:inline>
      // First-touch ad attribution. Stashes the landing query string (or the
      // external referrer) once per session so /api/lead can tell the shop
      // which campaign produced a lead — the form is often several clicks
      // after the ad click, by which point location.search is long gone.
      try {
        if (!sessionStorage.getItem('attr')) {
          var q = location.search.slice(1, 300);
          if (/utm_|gclid|gbraid|wbraid|fbclid|msclkid/.test(q)) sessionStorage.setItem('attr', q);
          else if (document.referrer && new URL(document.referrer).host !== location.host)
            sessionStorage.setItem('attr', 'ref=' + document.referrer.slice(0, 200));
        }
      } catch (e) { /* private mode / storage blocked — attribution is optional */ }
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <slot />

    {shopBadge && (
      <>
        <script id="merchantWidgetScript" src="https://www.gstatic.com/shopping/merchant/merchantwidget.js" defer></script>
        <script is:inline>
          // Google Customer Reviews seller-rating badge, shop pages only.
          // Desktop only on purpose: on mobile Google centres the widget at the
          // bottom of the viewport, which is exactly where .mobile-call-cta and
          // the product page's .buy-bar live (both ≤720px). Google asks that the
          // widget not be obscured, and we're not burying the call CTA under it,
          // so below the breakpoint we simply never start it.
          merchantWidgetScript.addEventListener('load', function () {
            if (!window.matchMedia('(min-width: 721px)').matches) return;
            merchantwidget.start({
              merchant_id: 5832297258,
              position: 'RIGHT_BOTTOM',
              region: 'AU',
            });
          });
        </script>
      </>
    )}
    <script>
      // Mobile nav toggle. One delegated handler in the layout covers both nav
      // implementations — SiteNav.astro (inner pages) and the homepage Nav in
      // sections.jsx — so they can't drift apart.
      const close = (nav) => {
        if (!nav || nav.dataset.open !== 'true') return;
        nav.dataset.open = 'false';
        nav.querySelector('.nav-toggle')?.setAttribute('aria-expanded', 'false');
      };

      document.addEventListener('click', (e) => {
        const nav = document.querySelector('.nav');
        if (!nav) return;
        const btn = e.target.closest('.nav-toggle');
        if (btn) {
          const open = nav.dataset.open !== 'true';
          nav.dataset.open = String(open);
          btn.setAttribute('aria-expanded', String(open));
        } else if (!e.target.closest('.nav')) {
          close(nav);
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        close(document.querySelector('.nav'));
        // Desktop mega menu opens on :focus-within, which no CSS can dismiss —
        // dropping focus is what closes it.
        if (document.activeElement?.closest('.mega')) document.activeElement.blur();
      });
    </script>
  </body>
</html>
